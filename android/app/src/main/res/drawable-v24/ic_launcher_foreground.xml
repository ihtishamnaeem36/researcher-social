<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportHeight="108"
    android:viewportWidth="108">

    <!-- Soft Drop Ambient Shadow -->
    <path
        android:fillColor="#33000000"
        android:pathData="M 54,86 L 16,65 L 54,45 L 92,65 Z" />

    <!-- Base Foundation Plate (Indigo-Cyan Gradient) -->
    <path
        android:strokeWidth="2.5"
        android:strokeColor="#818CF8"
        android:strokeLineJoin="round"
        android:pathData="M 54,80 L 20,62 L 54,44 L 88,62 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="20"
                android:startY="44"
                android:endX="88"
                android:endY="80"
                android:type="linear">
                <item android:color="#55818CF8" android:offset="0.0" />
                <item android:color="#3338BDF8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Intermediate Synthesizing Plate (Cyan-Indigo Gradient) -->
    <path
        android:strokeWidth="2.8"
        android:strokeColor="#38BDF8"
        android:strokeLineJoin="round"
        android:pathData="M 54,63 L 20,45 L 54,27 L 88,45 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="20"
                android:startY="27"
                android:endX="88"
                android:endY="63"
                android:type="linear">
                <item android:color="#7738BDF8" android:offset="0.0" />
                <item android:color="#44818CF8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Apex Discovery Crown Plate -->
    <path
        android:strokeWidth="3.2"
        android:strokeColor="#C084FC"
        android:strokeLineJoin="round"
        android:pathData="M 54,46 L 24,29 L 54,12 L 84,29 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="24"
                android:startY="12"
                android:endX="84"
                android:endY="46"
                android:type="linear">
                <item android:color="#AA38BDF8" android:offset="0.0" />
                <item android:color="#AAC084FC" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Radiant Focal Node of Scientific Discovery -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 54,22.5 A 6.5,6.5 0 1,1 53.99,22.5 Z" />

</vector>
